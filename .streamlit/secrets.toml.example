# Modelo de arquivo de variaveis de ambiente e segredos (.streamlit/secrets.toml)
# Este arquivo e mantido como template de governanca (secrets.toml e ignorado no .gitignore).
# A aplicacao opera nativamente com a base analitica processada em data/processed/cvm_indicadores_linha1_tratado.csv.

[app_config]
environment = "production"
data_source = "cvm_dfp_local_csv"
